# Private Ray topology used by `dapper ray init`.
# All numbered workers live in this one env file. Use `dapper ray init
# --region REGION` to select a regional group dynamically.
DAPPER_RAY_WORKER_ENV_PREFIX=DAPPER_RAY_WORKER
# Optional persistent regional mode. Leave blank to use every configured node.
# Set this to either two-node region when selecting a subset:
# DAPPER_RAY_REGION=us-central1

# Each numbered pair describes one existing GCE worker VM. INSTANCE is the
# GCE VM name; ZONE is that VM's zone. Add another numbered pair for each
# additional worker. Keep this file as a template and put real values in .env.
DAPPER_RAY_PORT=26379
# The Ray head is the machine where `dapper ray init` runs. It is separate
# from these worker entries and is displayed as `head`.

# Region A: two workers. Select with `--region us-central1`.
DAPPER_RAY_WORKER_01_INSTANCE=replace-with-first-worker-vm-name
DAPPER_RAY_WORKER_01_NAME=central-worker-a
DAPPER_RAY_WORKER_01_ZONE=us-central1-a
DAPPER_RAY_WORKER_02_INSTANCE=replace-with-second-worker-vm-name
DAPPER_RAY_WORKER_02_NAME=central-worker-b
DAPPER_RAY_WORKER_02_ZONE=us-central1-b

# Region B: two workers. Select with `--region us-east4`.
DAPPER_RAY_WORKER_03_INSTANCE=replace-with-third-worker-vm-name
DAPPER_RAY_WORKER_03_NAME=east-worker-a
DAPPER_RAY_WORKER_03_ZONE=us-east4-a
DAPPER_RAY_WORKER_04_INSTANCE=replace-with-fourth-worker-vm-name
DAPPER_RAY_WORKER_04_NAME=east-worker-b
DAPPER_RAY_WORKER_04_ZONE=us-east4-b
